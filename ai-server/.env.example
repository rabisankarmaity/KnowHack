PYTHON_VERSION=3.12.0
ENVIRONMENT=development
PORT=8000

ALLOWED_ORIGINS=http://localhost:5000,http://localhost:8080
AI_API_KEY=change_me_to_the_same_shared_secret_in_both_services

# LLM provider: huggingface (default) | openai | custom — all OpenAI-compatible.
LLM_PROVIDER=huggingface
# Leave empty to use the provider default (Hugging Face: https://router.huggingface.co/v1)
LLM_BASE_URL=
# Hugging Face access token (hf_...) — never commit a real token.
LLM_API_KEY=
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM_TIMEOUT_SECONDS=60
# json_object response_format: auto | on | off
LLM_JSON_MODE=auto

# Embeddings.
# EMBEDDING_PROVIDER: hash (default, deterministic, no network) | huggingface (model-backed).
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional — falls back to LLM_API_KEY when empty (do NOT commit a real token).
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_DIM=384

# Similarity signal weights (JSON). Optional; sensible defaults exist.
SIMILARITY_WEIGHTS={"problem":0.25,"architecture":0.15,"technology":0.20,"features":0.15,"research":0.10,"documentation":0.15}

# Mentor / RAG tuning.
RAG_TOP_K=6
MAX_CONTEXT_CHARS=12000

# File extraction
MAX_DOWNLOAD_MB=25
VECTOR_STORE_PATH=./data/vector_store.json