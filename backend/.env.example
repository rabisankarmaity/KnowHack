NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:8080,http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/knowhack

JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

COOKIE_DOMAIN=
COOKIE_SECURE=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=knowhack

MAX_FILE_SIZE_MB=25

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20


AI_SERVICE_URL=http://localhost:8000
AI_API_KEY=change_me_to_the_same_shared_secret_in_both_services
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=2
AI_RETRY_DELAY_MS=1500
AI_HEALTH_TIMEOUT_MS=120000
